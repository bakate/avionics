# Test Database Configuration
# Choose the appropriate configuration based on your environment

# ============================================================================
# Option 1: Docker PostgreSQL (RECOMMENDED for local development)
# ============================================================================
# Pros: Fast, preserves Neon credits, complete isolation
# Cons: Requires Docker installation
#
# Setup:
#   docker run -d --name avionics-test-db \
#     -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=avionics-db-test \
#     -p 5433:5432 postgres:16-alpine
#
#   pnpm test:setup
#   pnpm test:integration

PGHOST='localhost'
PGPORT=5433
PGDATABASE='avionics-db-test'
PGUSER='postgres'
PGPASSWORD='postgres'
PGSSLMODE='disable'

# ============================================================================
# Option 2: Neon Branch (REQUIRED for CI/CD, optional for local)
# ============================================================================
# Pros: Managed infrastructure, isolated from production
# Cons: Network dependency, consumes Neon credits
#
# Use this in CI/CD via GitHub Secrets:
#   NEON_TEST_HOST
#   NEON_TEST_DATABASE
#   NEON_TEST_USER
#   NEON_TEST_PASSWORD
#
# For local development with Neon (not recommended):
# Uncomment and configure these to use Neon test branch

# PGHOST='ep-xxx.us-east-2.aws.neon.tech'
# PGDATABASE='avionics'
# PGUSER='your-user'
# PGPASSWORD='your-password'
# PGSSLMODE='require'

# ============================================================================
# Recommendation
# ============================================================================
# Local:  Use Docker (Option 1) - saves Neon credits, faster
# CI/CD:  Use Neon (Option 2) - no Docker daemon needed
